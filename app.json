              "en": "Adjust",
              "fr": "Régler"
            },
            "values": [
              {
                "id": "up",
                "label": {
                  "en": "Brighten",
                  "fr": "Augmenter"
                }
              },
              {
                "id": "down",
                "label": {
                  "en": "Dim",
                  "fr": "Diminuer"
                }
              }
            ]
          }
        ]
      },
