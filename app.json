          "en": "Dim/Brighten",
          "fr": "Diminuer/Augmenter la luminosité"
        },
        "titleFormatted": {
          "en": "[[direction]] the brightness",
          "fr": "[[direction]] la luminosité"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=small-led-candles"
          },
          {
            "type": "dropdown",
            "name": "direction",
