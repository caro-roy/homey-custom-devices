          "fr": "Définir le mode de lumière"
        },
        "titleFormatted": {
          "en": "Set the light mode to [[mode]]",
          "fr": "Définir le mode de lumière sur [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=small-led-candles"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "fr": "Mode"
