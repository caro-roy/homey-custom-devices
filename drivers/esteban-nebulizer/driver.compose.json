{
  "name": {
    "en": "Esteban Nebulizer",
    "fr": "Brumisateur Esteban"
  },
  "class": "fan",
  "capabilities": [
    "onoff",
    "button.light",
    "button.brightness",
    "button.mist_mode"
  ],
  "capabilitiesOptions": {
    "button.light": {
      "title": {
        "en": "Toggle the light",
        "fr": "Allumer/éteindre la lumière"
      },
      "maintenanceAction": false
    },
    "button.brightness": {
      "title": {
        "en": "Next brightness",
        "fr": "Luminosité suivante"
      },
      "maintenanceAction": false
    },
    "button.mist_mode": {
      "title": {
        "en": "Next mist mode",
        "fr": "Mode de brume suivant"
      },
      "maintenanceAction": false
    }
  },
  "platforms": ["local"],
  "connectivity": ["infrared"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
